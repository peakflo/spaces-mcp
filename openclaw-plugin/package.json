{
  "name": "@peakflo/spaces",
  "version": "1.0.1",
  "type": "module",
  "description": "Spaces by Peakflo for OpenClaw: adds the hosted Spaces MCP server (Streamable HTTP, OAuth sign-in) to hand off finance and ops work and query workflows, data tables, reports, policy documents and approvals.",
  "keywords": [
    "accounting",
    "accounts-payable",
    "accounts-receivable",
    "approvals",
    "mcp",
    "finance",
    "workflows",
    "ai-agents",
    "peakflo"
  ],
  "license": "MIT",
  "author": "Peakflo Pte. Ltd.",
  "homepage": "https://spaces.peakflo.ai/docs/mcp/",
  "repository": {
    "type": "git",
    "url": "https://github.com/peakflo/spaces-mcp.git",
    "directory": "openclaw-plugin"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.10"
    },
    "build": {
      "openclawVersion": "2026.11.2"
    },
    "install": {
      "minHostVersion": ">=2026.10.10"
    }
  }
}
